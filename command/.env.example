APP_NAME=PollProof
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pollproof
DB_USERNAME=pollproof
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
POLLPROOF_EVIDENCE_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# PollProof
POLLPROOF_SMS_DRIVER=log
POLLPROOF_SMS_WEBHOOK_TOKEN=
POLLPROOF_OTP_TTL_MINUTES=10
POLLPROOF_SMS_NUMBER=
# Africa's Talking USSD: callback is https://<domain>/api/v1/ussd/africastalking/<POLLPROOF_USSD_TOKEN>
POLLPROOF_USSD_TOKEN=
POLLPROOF_USSD_CODE=
POLLPROOF_APP_URL=https://pollproof.ng/app
# Map on the overview, beside the 25% tracker: the state's map adapter in resources/js/maps/
# (niger). Blank for no map. Read at run time; no rebuild needed.
POLLPROOF_STATE_MAP=niger
# Spoken announcements in the command room, through a Kokoro TTS server. Off until set to true.
# Socket for a Kokoro on the same server; leave it blank to reach Kokoro over TCP at the URL.
POLLPROOF_VOICE_ENABLED=false
POLLPROOF_VOICE_SOCKET=
POLLPROOF_VOICE_URL=http://localhost/tts
POLLPROOF_VOICE_NAME=af_heart
POLLPROOF_VOICE_SPEED=1.0

# SMS: set POLLPROOF_SMS_DRIVER=termii to send for real
TERMII_API_KEY=
TERMII_SENDER_ID=PollProof
TERMII_CHANNEL=dnd

# Where command-room tables sort when a column header is clicked: server (default) asks the API
# to sort; client sorts the rows already in the browser. Read at build time (npm run build).
# Units, Audit log and Roster are paged by the server and always sort there.
VITE_SORT_MODE=server
